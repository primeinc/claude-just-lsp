{
  "description": "Runs just-lsp analyze after Edit or Write of justfile or .justfile in any letter case at any path; returns the report as additionalContext",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(//**/[Jj][Uu][Ss][Tt][Ff][Ii][Ll][Ee])",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/just-lsp-analyze.sh",
            "timeout": 30,
            "statusMessage": "just-lsp analyze"
          },
          {
            "type": "command",
            "if": "Edit(//**/.[Jj][Uu][Ss][Tt][Ff][Ii][Ll][Ee])",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/just-lsp-analyze.sh",
            "timeout": 30,
            "statusMessage": "just-lsp analyze"
          },
          {
            "type": "command",
            "if": "Write(//**/[Jj][Uu][Ss][Tt][Ff][Ii][Ll][Ee])",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/just-lsp-analyze.sh",
            "timeout": 30,
            "statusMessage": "just-lsp analyze"
          },
          {
            "type": "command",
            "if": "Write(//**/.[Jj][Uu][Ss][Tt][Ff][Ii][Ll][Ee])",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/just-lsp-analyze.sh",
            "timeout": 30,
            "statusMessage": "just-lsp analyze"
          }
        ]
      }
    ]
  }
}
